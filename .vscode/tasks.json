{
    "tasks": [
        {
            "type": "shell",
            "label": "Build Tempo C++ (g++)",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O2",
                "-o", "tempo.exe",
                "main.cpp",
                "-x", "c",
                "sqlite3.c"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles main.cpp as C++ and the vendored sqlite3.c amalgamation as C (-x c forces C mode since g++ would otherwise compile every input as C++ regardless of extension, which breaks sqlite3.c)."
        }
    ],
    "version": "2.0.0"
}
